# ==============================================================================
# Synchronized Spreadsheet Application - Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the root, or into backend-node/.env / backend-python/.env

# ------------------------------------------------------------------------------
# 1. Remote PostgreSQL Database Configuration (Persistent Storage)
# ------------------------------------------------------------------------------
# Connect your remote PostgreSQL instance.
# Automatically provisions tables: users, sheet_rows, sheet_columns, cell_formats, google_sheets_config.
DATABASE_URL=postgresql://username:password@your-remote-host.com:5432/your_database_name?sslmode=require

# ------------------------------------------------------------------------------
# 2. Node.js WebSocket Gateway Configuration
# ------------------------------------------------------------------------------
NODE_PORT=5000
NODE_HOST=0.0.0.0
PYTHON_SERVICE_URL=http://localhost:8000
WEBHOOK_SECRET=sync_secret_token_123
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 3. Python Sheets Sync Engine & Poller Configuration
# ------------------------------------------------------------------------------
PYTHON_PORT=8000
PYTHON_HOST=0.0.0.0
POLL_INTERVAL_SECONDS=3.0
ENABLE_POLLING=true
NODE_INTERNAL_URL=http://localhost:5000/internal/sync-event

# ------------------------------------------------------------------------------
# 4. Google Sheets API v4 Integration (Service Account Credentials)
# ------------------------------------------------------------------------------
# NOTE: SPREADSHEET_ID and SHEET_NAME are no longer stored statically in .env!
# They are dynamically managed and persisted in PostgreSQL via the web app's '/overview' route.
# Provide Google Service Account credentials using either file path or raw JSON:
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
# Or provide the raw JSON content of your Google Service Account:
GOOGLE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------------------
# 5. Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
